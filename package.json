{
    "name": "cure-vscode-wallpaper",
    "displayName": "cure-vscode-wallpaper",
    "description": "Wallpaper for vscode",
    "version": "0.0.1",
    "author": "Hosinoharu",
    "publisher": "Hosinoharu",
    "license": "MIT",
    "repository": "https://github.com/Hosinoharu/cure-vscode-wallpaper",
    "engines": {
        "vscode": "^1.118.0"
    },
    "categories": [
        "Other"
    ],
    "icon": "icons/icon-128.png",
    "activationEvents": [],
    "main": "./out/extension.js",
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/vscode": "^1.118.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "22.x",
        "typescript-eslint": "^8.56.1",
        "eslint": "^9.39.3",
        "typescript": "^5.9.3",
        "@vscode/test-cli": "^0.0.12",
        "@vscode/test-electron": "^2.5.2"
    },
    "contributes": {
        "commands": [
            {
                "command": "cure-vscode-wallpaper.helloWorld",
                "title": "Hello World"
            }
        ]
    }
}
